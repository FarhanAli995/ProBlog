# ============================================================
# ProBlog Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
# docker-compose reads variables from a real .env file automatically.
# For Vercel: Add these as Environment Variables in the Vercel Dashboard
# For Production: NEVER commit .env to git! This is just a template.
# ============================================================

# ---------- Django Core ----------
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production

# Set to False in production (Vercel sets this automatically)
DJANGO_DEBUG=True

# Production: yourdomain.com,www.yourdomain.com,.vercel.app,.now.sh
# Development: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Email Configuration (SMTP) ----------
# Use environment variables for email credentials (DO NOT hardcode)
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# ---------- Production Superuser (for Vercel deployment) ----------
# Set these in Vercel Environment Variables only, never in code
PROD_SUPERUSER_USERNAME=your-admin-username
PROD_SUPERUSER_EMAIL=your-admin-email@example.com
PROD_SUPERUSER_PASSWORD=your-secure-password-here

# ---------- Custom Domain (optional) ----------
CUSTOM_DOMAIN=your-domain.com

# ---------- Production Database (PostgreSQL on Neon/Vercel) ----------
# Get this from your database provider (Neon, Supabase, AWS RDS, etc.)
# NEVER commit the actual DATABASE_URL to git or vercel.json!
# Set it as a secret environment variable in Vercel Dashboard.
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# ---------- Security Notes ----------
# 1. DO NOT hardcode passwords, API keys, or secrets in settings.py
# 2. For Vercel: Add DATABASE_URL and DJANGO_SECRET_KEY to Environment Variables
# 3. For Docker: Use .env file (add to .gitignore)
# 4. Rotate database passwords immediately if ever exposed
# 5. Use separate database users for production vs development
