# Copy this file to .env and adjust values as needed.
# docker-compose reads variables from a real .env file automatically.

# Django Core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Gmail SMTP)
EMAIL_HOST_USER=alyyfarhan4@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=alyyfarhan4@gmail.com

# Production Superuser (for Vercel deployment)
# Set these in Vercel Environment Variables
PROD_SUPERUSER_USERNAME=farhanbabu
PROD_SUPERUSER_EMAIL=alyyfarhan4@gmail.com
PROD_SUPERUSER_PASSWORD=your-secure-password-here

# Custom Domain (optional)
CUSTOM_DOMAIN=your-domain.com

# Production Database URL (for Vercel/Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Security - Move sensitive data to environment variables
# DO NOT hardcode passwords in settings.py
